{
  "contract_version": "1.0.0",
  "description": "Canonical data request for the manufacturing analytics pilot. Table and column names are the pilot's canonical model, not Infor M3 names; see docs/M3_MAPPING.md.",
  "datasets": [
    {"name": "sites", "table": "sites", "required": true, "key": ["site_id"], "business_key": ["site_code"],
     "columns": ["site_id", "site_code", "name", "country"], "optional_columns": []},
    {"name": "customers", "table": "customers", "required": true, "key": ["customer_id"], "business_key": ["customer_code"],
     "columns": ["customer_id", "customer_code", "name"], "optional_columns": ["country", "region"]},
    {"name": "item_master", "table": "items", "required": true, "key": ["item_id"], "business_key": ["item_code"],
     "columns": ["item_id", "item_code", "item_type", "uom"], "optional_columns": ["product_family", "is_active"],
     "allowed_values": {"item_type": ["FG", "SUBASSY", "RAW", "PACKAGING"]}},
    {"name": "bom_headers", "table": "bom_headers", "required": true, "key": ["bom_id"],
     "columns": ["bom_id", "parent_item_id", "revision", "effective_from"], "optional_columns": ["effective_to", "status"],
     "date_order": [["effective_from", "effective_to"]]},
    {"name": "bom_components", "table": "bom_components", "required": true, "key": ["bom_component_id"],
     "columns": ["bom_component_id", "bom_id", "component_item_id", "quantity_per"], "optional_columns": ["scrap_pct"],
     "positive": ["quantity_per"]},
    {"name": "routings", "table": "routing_headers", "required": true, "key": ["routing_id"],
     "columns": ["routing_id", "item_id", "revision", "effective_from"], "optional_columns": ["effective_to"],
     "date_order": [["effective_from", "effective_to"]]},
    {"name": "routing_operations", "table": "routing_operations", "required": true, "key": ["routing_operation_id"],
     "columns": ["routing_operation_id", "routing_id", "seq_no", "work_centre_id", "setup_time_minutes", "run_time_minutes_per_unit"],
     "optional_columns": ["queue_time_minutes", "transfer_time_minutes", "yield_pct", "batch_size"],
     "max_null_pct": {"setup_time_minutes": 5, "run_time_minutes_per_unit": 5, "work_centre_id": 5}},
    {"name": "work_centres", "table": "work_centres", "required": true, "key": ["work_centre_id"], "business_key": ["work_centre_code"],
     "columns": ["work_centre_id", "work_centre_code", "site_id", "shifts_per_day", "hours_per_shift", "days_per_week"],
     "optional_columns": ["cost_per_hour", "process_type"]},
    {"name": "capacity_calendar", "table": "capacity_calendar", "required": true, "key": ["capacity_calendar_id"],
     "columns": ["work_centre_id", "week_start_date", "calendar_hours", "planned_downtime_hours", "availability_pct"],
     "optional_columns": ["available_hours", "effective_hours"]},
    {"name": "forecast_versions", "table": "forecast_versions", "required": true, "key": ["forecast_version_id"],
     "columns": ["forecast_version_id", "snapshot_date"], "optional_columns": ["description"],
     "history": {"date_column": "snapshot_date", "min_weeks": 26, "cadence_days": 7}},
    {"name": "customer_forecasts", "table": "customer_forecasts", "required": true, "key": ["forecast_id"],
     "columns": ["forecast_id", "forecast_version_id", "customer_id", "item_id", "site_id", "delivery_period_start", "qty"],
     "optional_columns": [], "max_null_pct": {"customer_id": 2}},
    {"name": "sales_orders", "table": "sales_orders", "required": true, "key": ["sales_order_id"], "business_key": ["order_number"],
     "columns": ["sales_order_id", "order_number", "customer_id", "site_id", "order_date"], "optional_columns": ["status"],
     "history": {"date_column": "order_date", "min_weeks": 26}},
    {"name": "sales_order_lines", "table": "sales_order_lines", "required": true, "key": ["line_id"],
     "columns": ["line_id", "sales_order_id", "item_id", "qty", "requested_ship_date"], "optional_columns": ["promised_ship_date", "unit_price"],
     "positive": ["qty"]},
    {"name": "production_orders", "table": "production_orders", "required": true, "key": ["production_order_id"], "business_key": ["order_number"],
     "columns": ["production_order_id", "order_number", "item_id", "site_id", "qty", "status", "planned_start", "planned_finish"],
     "optional_columns": ["routing_id", "actual_start", "actual_finish"],
     "date_order": [["planned_start", "planned_finish"], ["actual_start", "actual_finish"]]},
    {"name": "production_order_operations", "table": "production_order_operations", "required": true, "key": ["po_operation_id"],
     "columns": ["po_operation_id", "production_order_id", "seq_no", "work_centre_id", "status"],
     "optional_columns": ["routing_operation_id", "actual_start", "actual_finish"],
     "date_order": [["actual_start", "actual_finish"]]},
    {"name": "inventory", "table": "inventory", "required": true, "key": ["inventory_id"],
     "columns": ["item_id", "warehouse_id", "snapshot_date", "on_hand_qty"], "optional_columns": ["uom"]},
    {"name": "purchase_order_lines", "table": "purchase_order_lines", "required": false, "key": ["po_line_id"],
     "columns": ["po_line_id", "item_id", "qty_ordered", "expected_receipt_date", "status"], "optional_columns": ["qty_received", "unit_cost"]},
    {"name": "standard_costs", "table": "standard_costs", "required": false, "key": ["standard_cost_id"],
     "columns": ["item_id", "effective_from", "material_cost", "labour_cost", "overhead_cost"], "optional_columns": ["effective_to", "cost_source"],
     "date_order": [["effective_from", "effective_to"]]},
    {"name": "wip", "table": "wip", "required": false, "key": ["wip_id"],
     "columns": ["production_order_id", "item_id", "qty", "stage_entered_at", "snapshot_date"], "optional_columns": ["work_centre_id"]}
  ],
  "relationships": [
    {"child": "bom_headers.parent_item_id", "parent": "items.item_id", "on_orphan": "BLOCK"},
    {"child": "bom_components.bom_id", "parent": "bom_headers.bom_id", "on_orphan": "BLOCK"},
    {"child": "bom_components.component_item_id", "parent": "items.item_id", "on_orphan": "WARN"},
    {"child": "routing_headers.item_id", "parent": "items.item_id", "on_orphan": "BLOCK"},
    {"child": "routing_operations.work_centre_id", "parent": "work_centres.work_centre_id", "on_orphan": "WARN"},
    {"child": "customer_forecasts.forecast_version_id", "parent": "forecast_versions.forecast_version_id", "on_orphan": "BLOCK"},
    {"child": "customer_forecasts.customer_id", "parent": "customers.customer_id", "on_orphan": "WARN"},
    {"child": "customer_forecasts.item_id", "parent": "items.item_id", "on_orphan": "BLOCK"},
    {"child": "sales_order_lines.sales_order_id", "parent": "sales_orders.sales_order_id", "on_orphan": "BLOCK"},
    {"child": "sales_order_lines.item_id", "parent": "items.item_id", "on_orphan": "BLOCK"},
    {"child": "production_order_operations.production_order_id", "parent": "production_orders.production_order_id", "on_orphan": "BLOCK"},
    {"child": "production_orders.routing_id", "parent": "routing_headers.routing_id", "on_orphan": "WARN"},
    {"child": "inventory.item_id", "parent": "items.item_id", "on_orphan": "WARN"}
  ],
  "bom_depth": {"min_levels": 3, "max_levels": 9},
  "forecast_revisions": {"min_median_revisions_per_bucket": 2}
}
